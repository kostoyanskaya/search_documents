LLM_API_KEY=your_api_key_here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
# LLM_JSON_MODE=true
# LLM_DAILY_REQUEST_CAP=5000

# --- Models (multilingual: Russian + English, cross-lingual) ---
EMBEDDING_MODEL=intfloat/multilingual-e5-small    # lighter: ...-small   heavier/better: BAAI/bge-m3
# RERANKER_MODEL=cross-encoder/mmarco-mMiniLMv2-L12-H384-v1  # default (fast); more accurate but slower: BAAI/bge-reranker-v2-m3 ; empty = disabled
# RERANK_MIN_SCORE=0.01 
# EMBEDDING_REVISION=<commit sha>
# RERANKER_REVISION=<commit sha>

# OCR_ENABLED=true
# OCR_LANGUAGES=rus+eng
# OCR_MAX_PAGES=100

CORS_ORIGINS=http://localhost:5173
SESSION_COOKIE_SECURE=false
# SESSION_TTL_MINUTES=240
# ENABLE_API_DOCS=false
# ACCESS_CODE=change-me          # optional gate: nobody can use the app (or spend your LLM budget) without it

# Observability 
# LOG_FORMAT=json 
# ENABLE_METRICS=true
# METRICS_TOKEN=...
# SENTRY_DSN=...

# Limits (defaults shown)
MAX_UPLOAD_MB=200
# MAX_FILES_PER_UPLOAD=50
# MAX_DOCS_PER_SESSION=50
# MAX_SESSION_TOTAL_MB=300
# RATE_LIMIT_QUERY_PER_MIN=10
# RATE_LIMIT_UPLOAD_PER_MIN=10
# AGENT_MAX_REFORMULATIONS=2
# AGENT_SQL_MAX_ATTEMPTS=3
# SQL_TIMEOUT_S=10
